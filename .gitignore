
# Python environments
.venv/
venv/
env/
ENV/
node_modules/
.playwright-cli/

# Python cache and build artifacts
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.pytest_cache/
# Jupyter temporary files
.ipynb_checkpoints/

# Temporary speech segments and build intermediates
webapp/.narration_build/

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example

# Downloaded NSL-KDD source files and generated pipeline outputs
data-pipeline/**/raw/
data-pipeline/**/output/
# Keep source data and generated output from the old layout ignored as well.
dataset/rawdata/
data-pipeline/output/
# Keep the existing MLP reports and plots tracked at their new location.
!data-pipeline/NSL-KDD/output/
data-pipeline/NSL-KDD/output/*
!data-pipeline/NSL-KDD/output/model_runs/
data-pipeline/NSL-KDD/output/model_runs/*
!data-pipeline/NSL-KDD/output/model_runs/mlp/
data-pipeline/NSL-KDD/output/model_runs/mlp/*
!data-pipeline/NSL-KDD/output/model_runs/mlp/results_binary.json
!data-pipeline/NSL-KDD/output/model_runs/mlp/results_multiclass.json
!data-pipeline/NSL-KDD/output/model_runs/mlp/plots/
data-pipeline/NSL-KDD/output/model_runs/mlp/plots/*
!data-pipeline/NSL-KDD/output/model_runs/mlp/plots/*.png
# Trained model artifacts and experiment logs
# Ignore model artifacts by default
*.pkl
*.pickle
*.joblib
*.h5
*.keras
*.onnx
*.pt
*.pth
# Autoencoder artifacts explicitly tracked for the team.
!model/autoencoder/scaler.pkl
!model/autoencoder/autoencoder.pth
model/isolation-forest/backup/
model/autoencoder/backup/
model/mlp/backup/
model/mlp/Backup/
model/xgboost/backup/
# Experiment logs
mlruns/
wandb/

# Editors and operating system files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

#Agent skills
.agents/