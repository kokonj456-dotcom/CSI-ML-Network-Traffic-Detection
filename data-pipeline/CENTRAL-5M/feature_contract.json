{
  "contract_version": 6,
  "pipeline_name": "CENTRAL-5M",
  "record_key": "record_id",
  "supported_datasets": [
    "NSL-KDD",
    "UNSW-NB15",
    "CIC-IDS2017",
    "BoT-IoT",
    "CIC-IDS2018",
    "ToN-IoT"
  ],
  "storage_format": "Parquet-First (.parquet)",
  "table_separation": {
    "features": "model inputs only plus record_id; drop record_id before fit/predict",
    "labels": [
      "record_id",
      "source_dataset",
      "label_raw",
      "attack_category_id",
      "label_binary"
    ],
    "metadata": [
      "record_id",
      "source_dataset"
    ]
  },
  "candidate_features": {
    "duration": {
      "type": "numeric",
      "unit": "seconds",
      "transform": "log1p",
      "sources": {
        "NSL-KDD": "duration",
        "UNSW-NB15": "dur",
        "CIC-IDS2017": "flow_duration",
        "BoT-IoT": "dur",
        "CIC-IDS2018": "Flow Duration",
        "ToN-IoT": "duration"
      }
    },
    "protocol": {
      "type": "categorical",
      "categories": [
        "tcp",
        "udp",
        "icmp",
        "other"
      ],
      "transform": "OneHotEncoder(handle_unknown=ignore), fit on train only",
      "sources": {
        "NSL-KDD": "protocol_type",
        "UNSW-NB15": "proto",
        "CIC-IDS2017": "protocol",
        "BoT-IoT": "proto",
        "CIC-IDS2018": "Protocol",
        "ToN-IoT": "proto"
      }
    },
    "bytes_forward": {
      "type": "numeric",
      "unit": "bytes",
      "transform": "log1p",
      "sources": {
        "NSL-KDD": "src_bytes",
        "UNSW-NB15": "sbytes",
        "CIC-IDS2017": "total_fwd_bytes",
        "BoT-IoT": "sbytes",
        "CIC-IDS2018": "Tot Fwd Pkts / Total Length of Fwd Packets",
        "ToN-IoT": "src_bytes"
      }
    },
    "bytes_backward": {
      "type": "numeric",
      "unit": "bytes",
      "transform": "log1p",
      "sources": {
        "NSL-KDD": "dst_bytes",
        "UNSW-NB15": "dbytes",
        "CIC-IDS2017": "total_bwd_bytes",
        "BoT-IoT": "dbytes",
        "CIC-IDS2018": "Tot Bwd Pkts / Total Length of Bwd Packets",
        "ToN-IoT": "dst_bytes"
      }
    }
  },
  "joint_model_profile": {
    "name": "joint_v2",
    "numeric_inputs": [
      "duration",
      "bytes_forward",
      "bytes_backward"
    ],
    "categorical_inputs": {
      "protocol": [
        "tcp",
        "udp",
        "icmp",
        "other"
      ],
      "service_group": [
        "dns",
        "ftp",
        "http",
        "https_ssl",
        "smtp",
        "ssh",
        "other"
      ],
      "conn_state_group": [
        "established",
        "no-reply",
        "reset",
        "other"
      ]
    },
    "categorical_output_prefixes": {
      "protocol": "proto",
      "service_group": "service",
      "conn_state_group": "state"
    },
    "numeric_features": {
      "log_duration": "log1p(duration)",
      "log_bytes_forward": "log1p(bytes_forward)",
      "log_bytes_backward": "log1p(bytes_backward)",
      "signed_log_bytes_ratio": "log1p(bytes_forward) - log1p(bytes_backward)"
    },
    "categorical_encoding": "OneHotEncoder with fixed categories; fit on train only",
    "numeric_scaling": "StandardScaler fit on train only",
    "expected_model_feature_count": 19,
    "unknown_categories": "Map to other before one-hot encoding",
    "missing_required_values": "Reject missing numerics/protocol. Unavailable service/state represented as other."
  },
  "mitre_6class_taxonomy": {
    "0": {
      "name": "Benign / Normal",
      "tactic": "Baseline Operations"
    },
    "1": {
      "name": "Denial of Service (DoS)",
      "tactic": "TA0040: Impact (T1498/T1499)"
    },
    "2": {
      "name": "Reconnaissance & Probing",
      "tactic": "TA0043: Recon / TA0007: Discovery (T1595/T1046)"
    },
    "3": {
      "name": "Exploits & PrivEsc",
      "tactic": "TA0001: Initial Access / TA0004: PrivEsc (T1190/T1068)"
    },
    "4": {
      "name": "Credential Abuse (R2L)",
      "tactic": "TA0006: Credential Access (T1110/T1078)"
    },
    "5": {
      "name": "Malware, C2 & Botnet",
      "tactic": "TA0011: C2 / TA0008: Lateral Movement (T1071/T1210)"
    }
  },
  "never_model_features": [
    "source_dataset",
    "orig_row_id",
    "capture_time",
    "split_group",
    "sample_weight",
    "dedup_flag",
    "label_raw",
    "attack_category",
    "label_binary",
    "difficulty_level",
    "raw IP addresses",
    "Flow ID",
    "raw timestamp"
  ]
}
